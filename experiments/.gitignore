# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# Generated per-run build artifacts (reproducible; do not commit)
corpus/real/
corpus/distractor/
corpus/padding/
corpus/manifest.json
results/raw/
results/computed/

# Materialized per-run subset corpora (copied from the committed superset at run time; reproducible).
# Everything under corpus/ EXCEPT the permanent superset/subsets/embeddings is a run artifact.
corpus/*/
!corpus/superset/
!corpus/subsets/
!corpus/embeddings/

# PERMANENT, COMMITTED data (the frozen superset, embeddings cache, named subsets + task sets):
#   corpus/superset/   corpus/subsets/   corpus/embeddings/   tasks/subsets/
# These are intentionally NOT ignored — they are the source of truth for reproducible, comparable runs.
