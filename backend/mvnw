#!/bin/sh
# Maven Wrapper bootstrap script
# This script downloads and runs the Maven wrapper JAR if not already present.

set -e

MAVEN_WRAPPER_JAR=".mvn/wrapper/maven-wrapper.jar"
MAVEN_WRAPPER_PROPERTIES=".mvn/wrapper/maven-wrapper.properties"

# Resolve the project base directory
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$SCRIPT_DIR"

if [ ! -f "$MAVEN_WRAPPER_PROPERTIES" ]; then
  echo "Error: $MAVEN_WRAPPER_PROPERTIES not found." >&2
  exit 1
fi

# Read distribution URL from properties
distributionUrl=$(grep -E '^distributionUrl=' "$MAVEN_WRAPPER_PROPERTIES" | cut -d'=' -f2-)

if [ -z "$distributionUrl" ]; then
  echo "Error: distributionUrl not found in $MAVEN_WRAPPER_PROPERTIES" >&2
  exit 1
fi

# If Maven is available on PATH, use it directly
if command -v mvn >/dev/null 2>&1; then
  exec mvn "$@"
fi

# Otherwise download and extract Maven
MAVEN_HOME="$HOME/.m2/wrapper/dists/$(basename "$distributionUrl" .zip)"

if [ ! -d "$MAVEN_HOME" ]; then
  echo "Downloading Maven from $distributionUrl..."
  mkdir -p "$MAVEN_HOME"
  TEMP_FILE=$(mktemp)
  curl -fsSL "$distributionUrl" -o "$TEMP_FILE"
  unzip -qo "$TEMP_FILE" -d "$MAVEN_HOME"
  rm -f "$TEMP_FILE"
fi

MVN_CMD=$(find "$MAVEN_HOME" -name mvn -type f | head -1)

if [ -z "$MVN_CMD" ]; then
  echo "Error: Could not find mvn executable in $MAVEN_HOME" >&2
  exit 1
fi

chmod +x "$MVN_CMD"
exec "$MVN_CMD" "$@"
